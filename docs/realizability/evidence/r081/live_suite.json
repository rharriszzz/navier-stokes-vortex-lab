{
  "schema": 1,
  "contract_id": "R081-PC-MONITOR-V1",
  "kind": "future_benign_validation_specification",
  "implementation_present": false,
  "live_execution_authorized_by_R081": false,
  "physical_execution_enabled": false,
  "interpreter": "/tmp/navier-fenicsx/bin/python",
  "python_version": "3.12.13",
  "machine": {"label": "PC/WSL", "hostname": "daisy", "architecture": "x86_64"},
  "interface": {
    "entry": "monitor_validation.py",
    "operations": ["inspect", "fixtures", "live"],
    "child_entry": "benign_child.py",
    "child_command_prefix": ["/tmp/navier-fenicsx/bin/python", "-B", "benign_child.py"],
    "source_binding": "source_manifest.json",
    "live_requires": ["review_binding", "contract_sha256", "source_sha256", "capability_binding", "fixture_binding", "fresh_headroom", "exclusive_ledger", "delegated_unit_guard", "native_job_helper"],
    "arbitrary_child_commands": false
  },
  "budgets": {
    "cumulative_wall_seconds": 180,
    "shared_setup_seconds": 30,
    "case_reservation_seconds": 12,
    "case_active_seconds": 5,
    "case_cleanup_seconds": 5,
    "case_report_seconds": 2,
    "final_validation_reporting_seconds": 30,
    "workload_rss_mib": 512,
    "maximum_payload_mib": 384,
    "linux_unit_memory_max_mib": 768,
    "linux_unit_swap_max_bytes": 0,
    "linux_unit_pids_max": 32,
    "native_sampled_working_set_mib": 128,
    "unexpected_stop_allows_retry": false,
    "unknown_open_attempt_allows_retry": false
  },
  "policy": {
    "guest_launch_available_mib": 4096,
    "windows_launch_available_mib": 1536,
    "windows_runtime_available_mib": 1024,
    "launch_max_age_from_acquisition_start_seconds": 30,
    "tree_interval_seconds": 0.05,
    "benign_suite_max_tree_decision_gap_seconds": 0.1,
    "host_request_interval_seconds": 0.5,
    "host_response_deadline_seconds_exclusive": 0.5,
    "host_max_gap_from_previous_send_seconds": 1,
    "native_heartbeat_timeout_seconds": 1,
    "max_wire_line_bytes": 4096,
    "max_pending_requests": 1,
    "max_reply_queue": 1,
    "physical_limits_unchanged": {"wall_seconds": 180, "rss_mib": 1536}
  },
  "calibration": {
    "processes": 3,
    "per_process_payload_plateaus_mib": [0, 16, 64, 128],
    "buffers_replaced_not_stacked": true,
    "touch_every_page": true,
    "barrier_stage_max_seconds": 0.25,
    "minimum_consecutive_samples_per_plateau": 2,
    "per_process_delta_absolute_tolerance_mib": 8,
    "per_process_delta_relative_tolerance": 0.1,
    "tolerance_rule": "max(absolute, relative * payload)"
  },
  "cases": [
    {"id": "L01", "child_args": ["sleep", "--seconds", "3"], "fault": null, "expected": "completed"},
    {"id": "L02", "child_args": ["allocation-tree", "--processes", "3", "--plateaus-mib", "0,16,64,128"], "fault": null, "expected": "completed_with_calibration"},
    {"id": "L03", "child_args": ["reparent-setsid", "--processes", "3"], "fault": null, "expected": "abnormal_root_exit_or_remaining_members"},
    {"id": "L04", "child_args": ["exit", "--code", "7", "--no-checkpoint"], "fault": null, "expected": "root_returncode_failure"},
    {"id": "L05", "child_args": ["sleep", "--seconds", "3"], "fault": {"inner_deadline_seconds": 0.25}, "expected": "wall_time_limit"},
    {"id": "L06", "child_args": ["allocation", "--mib", "32"], "fault": {"inner_rss_cap_mib": 24}, "expected": "tree_rss_limit"},
    {"id": "W01", "child_args": ["sleep", "--seconds", "3"], "fault": null, "expected": "completed_with_native_api_evidence"},
    {"id": "W02", "child_args": ["sleep", "--seconds", "3"], "fault": {"suppress_host_reply_seconds": 0.6}, "expected": "host_response_timeout"},
    {"id": "W03", "child_args": ["sleep", "--seconds", "3"], "fault": {"collector_exit_on_request": 2}, "expected": "host_eof_or_native_exit"},
    {"id": "I01", "child_args": ["sleep", "--seconds", "3"], "fault": {"inner_supervisor_hang": true, "guard_fault_deadline_seconds": 0.25}, "expected": "independent_guard_stop"}
  ],
  "every_case_requires": ["expected_status", "durable_partial_or_complete_report", "workload_cleanup_confirmed", "helper_job_cleanup_confirmed", "native_launcher_exit_verified", "all_attempt_accounting", "physical_attempt_untouched"],
  "unexecuted": ["all_live_cases", "cgroup_write_placement_kill", "native_helper_API_job_watchdog", "Mac_adapter", "FEM", "benchmarks"]
}
